{
  "name": "Nexomate Scheduled Google Sheets Email Extractor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "name": "Schedule Trigger (Every Hour)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "list"
        },
        "options": {}
      },
      "name": "Read Unprocessed Rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "e6a4b1c2-3d4e",
              "leftValue": "={{ $json['Extracted Email'] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Filter Unprocessed URLs",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5000/extract-from-urls",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "[\"{{ $json['Website URL'] }}\"]"
      },
      "name": "Call Email Extractor API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Extracted Email": "={{ $json.leads[0] ? $json.leads[0].email : 'Not Found' }}",
            "Quality Score": "={{ $json.leads[0] ? $json.leads[0].email_score : 0 }}",
            "Phone": "={{ $json.leads[0] ? $json.leads[0].phone : '' }}"
          }
        }
      },
      "name": "Write Emails to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [
        1050,
        300
      ]
    }
  ],
  "connections": {
    "Schedule Trigger (Every Hour)": {
      "main": [
        [
          {
            "node": "Read Unprocessed Rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Unprocessed Rows": {
      "main": [
        [
          {
            "node": "Filter Unprocessed URLs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Unprocessed URLs": {
      "main": [
        [
          {
            "node": "Call Email Extractor API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Email Extractor API": {
      "main": [
        [
          {
            "node": "Write Emails to Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
