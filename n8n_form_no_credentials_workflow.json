{
  "name": "Nexomate 1-Click Form (NO Credentials Needed)",
  "nodes": [
    {
      "parameters": {
        "path": "email-extractor-form",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "n8n Form Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "webhookId": "email-extractor-form"
    },
    {
      "parameters": {
        "jsCode": "// Extract URLs from form input or body\nconst body = $json.body || $json.query || {};\nconst rawUrls = body.urls || body['Website URLs'] || body.data || Object.values(body)[0] || '';\nconst urls = (typeof rawUrls === 'string' ? rawUrls.split('\\n') : [rawUrls]).map(u => String(u).trim()).filter(u => u.length > 0);\n\nreturn {\n  json: {\n    urls: urls\n  }\n};"
      },
      "name": "Parse URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5000/extract-from-urls",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.urls) }}"
      },
      "name": "Call Email Extractor API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        650,
        300
      ]
    }
  ],
  "connections": {
    "n8n Form Trigger": {
      "main": [
        [
          {
            "node": "Parse URLs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse URLs": {
      "main": [
        [
          {
            "node": "Call Email Extractor API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse URLs": {
      "main": [
        [
          {
            "node": "Call Email Extractor API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
